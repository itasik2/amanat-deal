generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum DealStatus {
  DRAFT
  WAITING_BUYER
  WAITING_PAYMENT
  FUNDS_SECURED
  WAITING_SHIPMENT
  SHIPPED
  DELIVERED
  INSPECTION
  COMPLETED
  PROBLEM_REPORTED
  CANCELLED
  EXPIRED
  WAITING_LEGAL_RESOLUTION
}

enum DealCategory {
  GOODS
  SERVICE
  REPAIR
  EQUIPMENT
  OTHER
}

enum DealRole {
  SELLER
  BUYER
  ADMIN
  SYSTEM
}

enum ProtectionPlan {
  BASIC
  EXTENDED
}

enum DisputeAssistanceStatus {
  REQUESTED
  ACTIVE
  SETTLEMENT_REACHED
  CLOSED
  CANCELLED
}

enum DisputeMessageType {
  MESSAGE
  PROPOSAL
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  SYSTEM
}

enum SettlementType {
  FULL_REFUND
  PARTIAL_REFUND
  RELEASE_TO_SELLER
  CUSTOM
}

model User {
  id        String   @id @default(cuid())
  phone     String?  @unique
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sellerDeals Deal[] @relation("SellerDeals")
  buyerDeals  Deal[] @relation("BuyerDeals")
  events      DealEvent[]
}

model Deal {
  id                  String         @id @default(cuid())
  publicCode          String         @unique @default(cuid())
  title               String
  description         String
  category            DealCategory
  amountKzt           Int
  platformFeeKzt      Int
  protectionPlan      ProtectionPlan @default(BASIC)
  inspectionHours     Int            @default(48)
  status              DealStatus     @default(DRAFT)
  sellerId            String?
  buyerId             String?
  acceptedBySellerAt  DateTime?
  acceptedByBuyerAt   DateTime?
  fundsSecuredAt      DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  inspectionEndsAt    DateTime?
  completedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  seller             User?              @relation("SellerDeals", fields: [sellerId], references: [id])
  buyer              User?              @relation("BuyerDeals", fields: [buyerId], references: [id])
  terms              DealTerm[]
  payments           Payment[]
  deliveries         Delivery[]
  evidence           EvidenceFile[]
  events             DealEvent[]
  disputeMessages    DisputeMessage[]
  disputeAssistance  DisputeAssistance?
}

model DealTerm {
  id        String   @id @default(cuid())
  dealId    String
  version   Int
  text      String
  hash      String
  createdAt DateTime @default(now())

  deal Deal @relation(fields: [dealId], references: [id])

  @@unique([dealId, version])
}

model Payment {
  id                  String   @id @default(cuid())
  dealId              String
  provider            String
  externalReference   String?  @unique
  amountKzt           Int
  platformFeeKzt      Int
  status              String
  rawPayloadHash      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  deal Deal @relation(fields: [dealId], references: [id])
}

model Delivery {
  id             String   @id @default(cuid())
  dealId         String
  carrier        String?
  trackingNumber String?
  status         String   @default("MANUAL")
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deal Deal @relation(fields: [dealId], references: [id])
}

model EvidenceFile {
  id              String   @id @default(cuid())
  dealId          String
  uploadedBy      String?
  uploaderRole    DealRole @default(SYSTEM)
  kind            String
  fileName        String
  mimeType        String   @default("application/octet-stream")
  sizeBytes       Int      @default(0)
  storageUrl      String
  sha256          String
  note            String?
  createdAt       DateTime @default(now())

  deal            Deal             @relation(fields: [dealId], references: [id])
  disputeMessages DisputeMessage[]

  @@index([dealId, createdAt])
}

model DisputeMessage {
  id             String             @id @default(cuid())
  dealId         String
  actorRole      DealRole
  messageType    DisputeMessageType @default(MESSAGE)
  body           String
  settlementType SettlementType?
  amountKzt      Int?
  evidenceId     String?
  proposalId     String?
  createdAt      DateTime           @default(now())

  deal     Deal          @relation(fields: [dealId], references: [id])
  evidence EvidenceFile? @relation(fields: [evidenceId], references: [id])

  @@index([dealId, createdAt])
  @@index([proposalId])
}

model DisputeAssistance {
  id              String                  @id @default(cuid())
  dealId          String                  @unique
  status          DisputeAssistanceStatus @default(REQUESTED)
  requestedByRole DealRole
  quotedFeeKzt    Int?
  requestedAt     DateTime                @default(now())
  activatedAt     DateTime?
  closedAt        DateTime?
  updatedAt       DateTime                @updatedAt

  deal Deal @relation(fields: [dealId], references: [id])
}

model DealEvent {
  id          String   @id @default(cuid())
  dealId      String
  actorId     String?
  actorRole   DealRole
  eventType   String
  fromStatus  DealStatus?
  toStatus    DealStatus?
  payload     Json?
  createdAt   DateTime @default(now())

  deal  Deal  @relation(fields: [dealId], references: [id])
  actor User? @relation(fields: [actorId], references: [id])
}
