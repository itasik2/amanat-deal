NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://amanat:amanat@localhost:5432/amanat_deal?schema=public
DIRECT_URL=postgresql://amanat:amanat@localhost:5432/amanat_deal?schema=public
# Comma-separated values are supported when more than one origin is needed.
WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:4000/api/v1
AUTH_SESSION_TTL_DAYS=30
OTP_HASH_SECRET=change-me-for-any-shared-or-production-environment
OTP_TTL_MINUTES=5
# Pilot/local only: echoes the OTP in the web UI. Never enable in production.
OTP_DEBUG_CODE_ENABLED=true
# When debug is disabled, OTP delivery is sent to this HTTPS webhook.
# Contract: POST JSON { channel, to, purpose, message, expiresAt }.
OTP_DELIVERY_WEBHOOK_URL=
OTP_DELIVERY_WEBHOOK_TOKEN=
OTP_DELIVERY_TIMEOUT_MS=8000
# Vercel Cron sends this value as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Local evidence storage is for development or a host with a persistent mounted volume.
# On Vercel, configure Cloudinary; ephemeral local storage is rejected.
EVIDENCE_STORAGE_DIR=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MOCK_ESCROW_ENABLED=true
DEFAULT_INSPECTION_HOURS=48
DEAL_INVITE_TTL_HOURS=72
PLATFORM_FEE_PERCENT=2
EXTENDED_PROTECTION_FEE_PERCENT=3
PLATFORM_FEE_MIN_KZT=500
PLATFORM_FEE_MAX_KZT=20000
