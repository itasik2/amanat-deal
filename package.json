{
  "name": "amanat-deal",
  "version": "0.1.0",
  "private": true,
  "description": "API-first MVP for protected deal flows with mock escrow.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\" \"npm run dev -w apps/admin\"",
    "build": "npm run build -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "test": "npm run test -ws --if-present",
    "prisma:generate": "node scripts/prisma.mjs generate",
    "prisma:migrate": "node scripts/prisma.mjs migrate",
    "prisma:reset": "node scripts/prisma.mjs reset",
    "prisma:studio": "node scripts/prisma.mjs studio"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^7.4.4",
    "typescript": "^5.6.0"
  }
}
