{
  "name": "amanat-deal",
  "version": "0.1.0",
  "private": true,
  "description": "API-first MVP for protected deal flows with mock escrow.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\" \"npm run dev -w apps/admin\"",
    "build": "npm run build -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "test": "npm run test -ws --if-present",
    "prisma:generate": "npm run prisma:generate -w packages/database",
    "prisma:migrate": "npm run prisma:migrate -w packages/database"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  }
}
