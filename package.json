{
  "name": "amanat-deal",
  "version": "0.1.0",
  "private": true,
  "description": "API-first MVP for protected deal flows with mock escrow.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/web\" \"npm run dev -w apps/admin\"",
    "build": "npm run build -ws --if-present",
    "lint": "npm run lint -ws --if-present",
    "test": "npm run test -ws --if-present",
    "prisma:generate": "dotenv -e .env -- prisma generate --schema packages/database/prisma/schema.prisma",
    "prisma:migrate": "dotenv -e .env -- prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "prisma:reset": "dotenv -e .env -- prisma migrate reset --schema packages/database/prisma/schema.prisma",
    "prisma:studio": "dotenv -e .env -- prisma studio --schema packages/database/prisma/schema.prisma"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "dotenv-cli": "^7.4.4",
    "typescript": "^5.6.0"
  }
}
